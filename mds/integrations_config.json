{
  "llm": {
    "provider": "openai",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "",
    "model": "gpt-4.1",
    "timeout_seconds": 30,
    "max_retries": 2
  },
  "embeddings": {
    "provider": "openai",
    "api_key_env": "OPENAI_API_KEY",
    "model": "text-embedding-3-small",
    "dimensions": 1536
  },
  "vector_store": {
    "provider": "chroma",
    "connection": {
      "host": "localhost",
      "port": 8001,
      "persist_directory": "backend/data/chroma"
    }
  },
  "graph_store": {
    "provider": "neo4j",
    "connection": {
      "uri": "bolt://localhost:7687",
      "user_env": "NEO4J_USER",
      "password_env": "NEO4J_PASSWORD"
    }
  },
  "telemetry": {
    "provider": "local",
    "trace_root": "backend/run_artifacts",
    "export_webhook": ""
  },
  "storage": {
    "rsb_root": "backend/data/rsb_packages",
    "evidence_root": "backend/data/evidence_packs",
    "brc_root": "backend/data/brc_exports"
  },
  "safety": {
    "synthetic_only": true,
    "watermark": "Simulation/Training Only",
    "block_actionable_fraud": true
  },
  "hooks": {
    "pre_run": "",
    "post_run": "",
    "pre_stage": "",
    "post_stage": "",
    "audit_sink": ""
  },
  "multimodal": {
    "model_cache_dir": {"env": "MODEL_CACHE_DIR", "default": ""},
    "cpu_threads": {"env": "MODEL_CPU_THREADS", "default": "0"}
  },
  "model_cache": {
    "shared_dir": {"env": "MODEL_CACHE_DIR", "default": ""}
  },
  "graph_sync": {
    "enabled": {"env": "GRAPH_SYNC_ENABLED", "default": "false"},
    "interval_seconds": {"env": "GRAPH_SYNC_INTERVAL", "default": "300"}
  },
  "rag_reranker": {
    "batch_size": {"env": "RERANKER_BATCH_SIZE", "default": "8"},
    "warmup_enabled": {"env": "RERANKER_WARMUP", "default": "false"}
  },
  "rag_evaluation": {
    "faithfulness_drop": {"env": "RAG_EVAL_DROP_FAITH", "default": "0.05"},
    "relevancy_drop": {"env": "RAG_EVAL_DROP_REL", "default": "0.05"}
  }
}
