{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RSB Rule Definition",
  "type": "object",
  "required": [
    "action",
    "confidence",
    "name",
    "rule_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["review", "block", "flag", "alert", "score", "monitor"]
    },
    "conditions": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  }
}
