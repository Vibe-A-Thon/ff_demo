{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AMC Manifest",
  "type": "object",
  "required": ["format", "amc_version", "team_id", "team_version", "created_at", "export_scope", "compatibility", "agents"],
  "properties": {
    "format": {"type": "string", "const": "AMC"},
    "amc_version": {"type": "string"},
    "team_id": {"type": "string"},
    "team_name": {"type": "string"},
    "team_version": {"type": "string"},
    "created_at": {"type": "string"},
    "export_scope": {
      "type": "object",
      "properties": {
        "include_memory_layers": {"type": "array", "items": {"type": "string"}},
        "include_logs": {"type": "string"},
        "include_models": {"type": "boolean"},
        "include_battle_refs": {"type": "boolean"},
        "time_window_days": {"type": "integer"}
      },
      "required": ["include_memory_layers", "include_logs", "include_models", "include_battle_refs", "time_window_days"]
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "fraud_forge_app_version": {"type": "string"},
        "runtime_version": {"type": "string"},
        "schema_versions": {"type": "object"},
        "prompt_manifest_hash": {"type": "string"},
        "tool_registry_hash": {"type": "string"}
      },
      "required": ["fraud_forge_app_version", "runtime_version", "schema_versions", "prompt_manifest_hash", "tool_registry_hash"]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id", "role", "agent_version", "path"],
        "properties": {
          "agent_id": {"type": "string"},
          "role": {"type": "string"},
          "agent_version": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "hashes": {
      "type": "object",
      "properties": {
        "pack_hash": {"type": "string"},
        "manifest_hash": {"type": "string"}
      }
    }
  }
}
