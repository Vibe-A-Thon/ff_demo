{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AMC Memory Entry",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {"type": "string"},
    "topic": {"type": "string"},
    "lesson": {"type": "string"},
    "summary": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number"},
    "event_type": {"type": "string"},
    "result": {"type": "string"}
  }
}
