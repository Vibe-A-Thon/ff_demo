{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AMC Agent Profile",
  "type": "object",
  "required": ["agent_id", "name", "role", "team_id"],
  "properties": {
    "agent_id": {"type": "string"},
    "name": {"type": "string"},
    "role": {"type": "string"},
    "team_id": {"type": "string"},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "memory_stats": {"type": "object"},
    "evolution": {"type": "object"}
  }
}
